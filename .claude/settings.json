{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *commit*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/roadmapGuard.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking the roadmap is updated…"
          }
        ]
      }
    ]
  }
}
